# Clé API SerpApi (https://serpapi.com/) utilisée pour interroger Google Shopping.
# Optionnel : vous pouvez aussi la renseigner depuis la page /admin de
# l'application une fois le serveur démarré (recommandé, plus simple).
SERPAPI_KEY=

# Mot de passe de la page d'administration (/admin).
# Optionnel : si absent, un mot de passe est généré automatiquement au
# premier démarrage et affiché dans les logs du serveur.
ADMIN_PASSWORD=

# Port d'écoute du serveur (optionnel)
PORT=3000
