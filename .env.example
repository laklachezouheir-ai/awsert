# Serper API key (https://serper.dev/) used to query Google Shopping.
# Optional: you can also set it from the app's /admin page once the
# server is running (recommended, simpler).
SERPER_API_KEY=

# Password for the admin page (/admin).
# Optional: if not set, a password is generated automatically on first
# startup and printed to the server logs.
ADMIN_PASSWORD=

# Port the server listens on (optional)
PORT=3000
